{
  "name": "lumora-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:customer": "pnpm --filter @lumora/customer-portal dev",
